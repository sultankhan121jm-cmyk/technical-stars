# Technical Stars Backend - Environment Config
# Copy this to .env and fill in the real values

PORT=5000
NODE_ENV=development

# Contact form email recipient (where submissions are sent)
CONTACT_EMAIL=info@technicalstars.com

# SMTP config for sending emails (Gmail example)
# Use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
